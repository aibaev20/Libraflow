@model PaginationViewModel<BookDepoSystem.Data.Models.Book>

@{
    ViewData["Title"] = @T.BookTableTitle;
}

<h2 class="m-3">@T.BookTableTitle</h2>

<div class="m-3">
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i>
    </a>
</div>

<div class="d-flex justify-content-between align-items-center m-3">

    <form method="get" class="w-100">
        <div class="row g-3 ">
            <div class="col-md-3">
                <label for="genre" class="form-label">@T.SelectGenreText</label>
                <select name="genre" id="genre" class="form-select">
                    <option value="">@T.AllGenresText</option>
                    <option value="@T.DystopiaGenreText" selected="@(ViewData["Genre"]?.ToString() == @T.DystopiaGenreText)">@T.DystopiaGenreText</option>
                    <option value="@T.BiographyGenreText" selected="@(ViewData["Genre"]?.ToString() == @T.BiographyGenreText)">@T.BiographyGenreText</option>
                    <option value="@T.GothicFictionGenreText" selected="@(ViewData["Genre"]?.ToString() == @T.GothicFictionGenreText)">@T.GothicFictionGenreText</option>
                    <option value="@T.DramaGenreText" selected="@(ViewData["Genre"]?.ToString() == @T.DramaGenreText)">@T.DramaGenreText</option>
                    <option value="@T.EpicGenreText" selected="@(ViewData["Genre"]?.ToString() == @T.EpicGenreText)">@T.EpicGenreText</option>
                    <option value="@T.HistoricalGenreText" selected="@(ViewData["Genre"]?.ToString() == @T.HistoricalGenreText)">@T.HistoricalGenreText</option>
                    <option value="@T.HistoricalFictionGenreText" selected="@(ViewData["Genre"]?.ToString() == @T.HistoricalFictionGenreText)">@T.HistoricalFictionGenreText</option>
                    <option value="@T.ClassicalGenreText" selected="@(ViewData["Genre"]?.ToString() == @T.ClassicalGenreText)">@T.ClassicalGenreText</option>
                    <option value="@T.ComicsGenreText" selected="@(ViewData["Genre"]?.ToString() == @T.ComicsGenreText)">@T.ComicsGenreText</option>
                    <option value="@T.MagicRealismGenreText" selected="@(ViewData["Genre"]?.ToString() == @T.MagicRealismGenreText)">@T.MagicRealismGenreText</option>
                    <option value="@T.MysteryGenreText" selected="@(ViewData["Genre"]?.ToString() == @T.MysteryGenreText)">@T.MysteryGenreText</option>
                    <option value="@T.NonFictionGenreText" selected="@(ViewData["Genre"]?.ToString() == @T.NonFictionGenreText)">@T.NonFictionGenreText</option>
                    <option value="@T.ScienceFictionGenreText" selected="@(ViewData["Genre"]?.ToString() == @T.ScienceFictionGenreText)">@T.ScienceFictionGenreText</option>
                    <option value="@T.PoetryGenreText" selected="@(ViewData["Genre"]?.ToString() == @T.PoetryGenreText)">@T.PoetryGenreText</option>
                    <option value="@T.AdventureGenreText" selected="@(ViewData["Genre"]?.ToString() == @T.AdventureGenreText)">@T.AdventureGenreText</option>
                    <option value="@T.RomanceGenreText" selected="@(ViewData["Genre"]?.ToString() == @T.RomanceGenreText)">@T.RomanceGenreText</option>
                    <option value="@T.SelfImprovementGenreText" selected="@(ViewData["Genre"]?.ToString() == @T.SelfImprovementGenreText)">@T.SelfImprovementGenreText</option>
                    <option value="@T.ThrillerGenreText" selected="@(ViewData["Genre"]?.ToString() == @T.ThrillerGenreText)">@T.ThrillerGenreText</option>
                    <option value="@T.PhilosophyGenreText" selected="@(ViewData["Genre"]?.ToString() == @T.PhilosophyGenreText)">@T.PhilosophyGenreText</option>
                    <option value="@T.PhilosophicalFictionGenreText" selected="@(ViewData["Genre"]?.ToString() == @T.PhilosophicalFictionGenreText)">@T.PhilosophicalFictionGenreText</option>
                    <option value="@T.FantasyGenreText" selected="@(ViewData["Genre"]?.ToString() == @T.FantasyGenreText)">@T.FantasyGenreText</option>
                    <option value="@T.HorrorGenreText" selected="@(ViewData["Genre"]?.ToString() == @T.HorrorGenreText)">@T.HorrorGenreText</option>
                    <option value="@T.FictionGenreText" selected="@(ViewData["Genre"]?.ToString() == @T.FictionGenreText)">@T.FictionGenreText</option>
                </select>
            </div>

            <div class="col-md-2">
                <label for="ageRange" class="form-label">@T.SelectAgeRangeText</label>
                <select name="ageRange" id="ageRange" class="form-select" value="@ViewData["AgeRange"]">
                    <option value="">@T.AllGenresText</option>
                    <option value="@T.KidsAgeRangeText" selected="@(ViewData["AgeRange"]?.ToString() == @T.KidsAgeRangeText)">@T.KidsAgeRangeText</option>
                    <option value="@T.TeenAgeRangeText" selected="@(ViewData["AgeRange"]?.ToString() == @T.TeenAgeRangeText)">@T.TeenAgeRangeText</option>
                    <option value="@T.AdultAgeRangeText" selected="@(ViewData["AgeRange"]?.ToString() == @T.AdultAgeRangeText)">@T.AdultAgeRangeText</option>
                </select>
            </div>

            <div class="col-md-3">
                <label for="sortBy" class="form-label">@T.SortText</label>
                <select name="sortBy" id="sortBy" class="form-select" value="@ViewData["SortBy"]">
                    <option value="">@T.SortByText</option>
                    <option value="@T.QuantityDescendingOrderText" selected="@(ViewData["SortBy"]?.ToString() == @T.QuantityDescendingOrderText)">@T.QuantityDescendingOrderText</option>
                    <option value="@T.QuantityAscendingOrderText" selected="@(ViewData["SortBy"]?.ToString() == @T.QuantityAscendingOrderText)">@T.QuantityAscendingOrderText</option>
                    <option value="@T.NameDescendingOrderText" selected="@(ViewData["SortBy"]?.ToString() == @T.NameDescendingOrderText)">@T.NameDescendingOrderText</option>
                    <option value="@T.NameAscendingOrderText" selected="@(ViewData["SortBy"]?.ToString() == @T.NameAscendingOrderText)">@T.NameAscendingOrderText</option>
                </select>
            </div>

            <div class="col-md-4 d-flex align-items-end gap-2">
                <input type="text" name="search" class="form-control" placeholder="..." value="@ViewData["Search"]"/>
                <input type="hidden" name="pageSize" value="@ViewData["PageSize"]"/>
                <button type="submit" class="btn btn-primary ms-2">
                    <i class="bi bi-search"></i>
                </button>
                <a asp-action="Books" class="btn btn-secondary ms-2">
                    <i class="bi bi-x-lg"></i>
                </a>
            </div>
        </div>
    </form>

</div>

<div class="table-responsive ">
    
<table class="table table-hover table-striped">
    <thead>
        <tr>
            <th>@T.BookTitleText</th>
            <th>@T.BookAuthorText</th>
            <th>@T.BookGenreText</th>
            <th>@T.BookLocationText</th>
            <th>@T.BookPublishedDateText</th>
            <th>@T.BookQuantityAvailableText</th>
            <th>@T.OperationsText</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Items.Any())
        {
            <tr>
                <td colspan="7">
                    <span class="d-block w-100 text-center">@T.NotFoundBooks</span>
                </td>
            </tr>
        }
        else
        {
            @foreach (var book in Model.Items)
            {
                <tr>
                    <td>@book.Title</td>
                    <td>@book.Author</td>
                    <td>@book.Genre</td>
                    <td>@book.Location</td>
                    <td>@book.PublishedDate.ToShortDateString()</td>
                    <td>@book.QuantityAvailable</td>

                    <td>
                        <div class="d-flex gap-2">
                            <a asp-action="Edit" asp-route-id="@book.BookId" asp-route-search="@ViewData["Search"]" asp-route-pageSize="@ViewData["PageSize"]" data-bs-toggle="tooltip" title="@T.ChangeBookText"  class="btn btn-sm btn-icon text-primary" >
                                <i class="bi bi-pencil-square"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@book.BookId" asp-route-search="@ViewData["Search"]" asp-route-pageSize="@ViewData["PageSize"]" data-bs-toggle="tooltip" title="@T.DeleteBookText" class="btn btn-sm btn-icon text-danger" >
                                <i class="bi bi-trash"></i>
                            </a>
                            <a asp-action="Details" asp-route-id="@book.BookId" asp-route-search="@ViewData["Search"]" asp-route-pageSize="@ViewData["PageSize"]" data-bs-toggle="tooltip" title="@T.DetailsBookText" class="btn btn-sm btn-icon text-dark">
                                <i class="bi bi-eye"></i>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
</div>

<div class="d-flex justify-content-between align-items-center m-3">
    @if (Model.HasPreviousPage)
    {
        <a asp-action="Books" asp-route-page="@(Model.PageIndex - 1)" asp-route-genre="@ViewData["Genre"]" asp-route-ageRange="@ViewData["AgeRange"]" asp-route-sortBy="@ViewData["SortBy"]" asp-route-pageSize="@ViewData["PageSize"]" asp-route-search="@ViewData["Search"]" class="btn btn-outline-primary">@T.PreviousPageText</a>
    }

    <span>@T.CurrentPageText @Model.PageIndex / @Model.TotalPages</span>

    @if (Model.HasNextPage)
    {
        <a asp-action="Books" asp-route-page="@(Model.PageIndex + 1)" asp-route-genre="@ViewData["Genre"]" asp-route-ageRange="@ViewData["AgeRange"]" asp-route-sortBy="@ViewData["SortBy"]" asp-route-pageSize="@ViewData["PageSize"]" asp-route-search="@ViewData["Search"]" class="btn btn-outline-primary">@T.NextPageText</a>
    }
</div>