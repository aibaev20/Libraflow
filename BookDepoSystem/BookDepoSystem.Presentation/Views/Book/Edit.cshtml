@model BookDepoSystem.Presentation.Models.BookViewModel

@{
    ViewData["Title"] = @T.EditBookTitle;
}

<h2 class="form-group">@T.EditBookTitle</h2>

<form asp-action="Edit" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="BookId" />

    <div class="container-fluid p-0">
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="CoverImage" class="control-label">@T.BookNewCoverImageText</label>
                    <input asp-for="CoverImage" class="form-control" type="file" name="coverImageFile" accept="image/jpeg, image/png"/>
                    <span asp-validation-for="CoverImage" class="text-danger"></span>
                </div>

                @if (Model.CoverImage != null)
                {
                    <div class="form-group">
                        <p>@T.BookCurrentCoverImageText</p>
                        <img src="~/img/books/@Model.CoverImage" alt="Book Cover" style="max-width: 150px;"/>
                    </div>
                }

                <div class="form-group">
                    <label asp-for="Title" class="control-label">@T.BookTitleText</label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Author" class="control-label">@T.BookAuthorText</label>
                    <input asp-for="Author" class="form-control" />
                    <span asp-validation-for="Author" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Genre" class="control-label">@T.BookGenreText</label>
                    <select asp-for="Genre" class="form-control">
                        <option value="">@T.SelectGenreText</option>
                        <option value="@T.DystopiaGenreText">@T.DystopiaGenreText</option>
                        <option value="@T.BiographyGenreText">@T.BiographyGenreText</option>
                        <option value="@T.GothicFictionGenreText">@T.GothicFictionGenreText</option>
                        <option value="@T.DramaGenreText">@T.DramaGenreText</option>
                        <option value="@T.EpicGenreText">@T.EpicGenreText</option>
                        <option value="@T.HistoricalGenreText">@T.HistoricalGenreText</option>
                        <option value="@T.HistoricalFictionGenreText">@T.HistoricalFictionGenreText</option>
                        <option value="@T.ClassicalGenreText">@T.ClassicalGenreText</option>
                        <option value="@T.ComicsGenreText">@T.ComicsGenreText</option>
                        <option value="@T.MagicRealismGenreText">@T.MagicRealismGenreText</option>
                        <option value="@T.MysteryGenreText">@T.MysteryGenreText</option>
                        <option value="@T.NonFictionGenreText">@T.NonFictionGenreText</option>
                        <option value="@T.ScienceFictionGenreText">@T.ScienceFictionGenreText</option>
                        <option value="@T.PoetryGenreText">@T.PoetryGenreText</option>
                        <option value="@T.AdventureGenreText">@T.AdventureGenreText</option>
                        <option value="@T.RomanceGenreText">@T.RomanceGenreText</option>
                        <option value="@T.SelfImprovementGenreText">@T.SelfImprovementGenreText</option>
                        <option value="@T.ThrillerGenreText">@T.ThrillerGenreText</option>
                        <option value="@T.PhilosophyGenreText">@T.PhilosophyGenreText</option>
                        <option value="@T.PhilosophicalFictionGenreText">@T.PhilosophicalFictionGenreText</option>
                        <option value="@T.FantasyGenreText">@T.FantasyGenreText</option>
                        <option value="@T.HorrorGenreText">@T.HorrorGenreText</option>
                        <option value="@T.FictionGenreText">@T.FictionGenreText</option>
                    </select>
                    <span asp-validation-for="Genre" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Location" class="control-label">@T.BookLocationText</label>
                    <input asp-for="Location" class="form-control" />
                    <span asp-validation-for="Location" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Information" class="control-label">@T.BookInformationText</label>
                    <textarea asp-for="Information" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Information" class="text-danger"></span>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="PublishedDate" class="control-label">@T.BookPublishedDateText</label>
                    <input asp-for="PublishedDate" type="date" class="form-control" placeholder="@T.BookPublishedDatePlaceholderText" />
                    <span asp-validation-for="PublishedDate" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="QuantityAvailable" class="control-label">@T.BookQuantityAvailableText</label>
                    <input asp-for="QuantityAvailable" type="number" class="form-control" min="0" />
                    <span asp-validation-for="QuantityAvailable" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Isbn" class="control-label">@T.BookISBNText</label>
                    <input asp-for="Isbn" class="form-control"/>
                    <span asp-validation-for="Isbn" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Sku" class="control-label">@T.BookSKUText</label>
                    <input asp-for="Sku" class="form-control"/>
                    <span asp-validation-for="Sku" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Pages" class="control-label">@T.BookPagesText</label>
                    <input asp-for="Pages" type="number" class="form-control" min="0"/>
                    <span asp-validation-for="Pages" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="AgeRange" class="control-label">@T.BookAgeRangeText</label>
                    <select asp-for="AgeRange" class="form-control">
                        <option value="">@T.SelectAgeRangeText</option>
                        <option value="@T.KidsAgeRangeText">@T.KidsAgeRangeText</option>
                        <option value="@T.TeenAgeRangeText">@T.TeenAgeRangeText</option>
                        <option value="@T.AdultAgeRangeText">@T.AdultAgeRangeText</option>
                    </select>
                    <span asp-validation-for="AgeRange" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="CoverType" class="control-label">@T.BookCoverTypeText</label>
                    <select asp-for="CoverType" class="form-control">
                        <option value="">@T.SelectCoverTypeText</option>
                        <option value="@T.HardCoverTypeText">@T.HardCoverTypeText</option>
                        <option value="@T.SoftCoverTypeText">@T.SoftCoverTypeText</option>
                    </select>
                    <span asp-validation-for="CoverType" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="row mt-4">
            <div class="col-12">
                <div class="form-group">
                    <button type="submit" class="btn btn-success">@T.SaveText</button>
                    <a asp-action="Books" class="btn btn-secondary">@T.CancelText</a>
                </div>
            </div>
        </div>
    </div>
</form>
