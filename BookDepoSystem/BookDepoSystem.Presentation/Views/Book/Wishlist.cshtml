@model List<BookDepoSystem.Data.Models.Book>
@{
    ViewData["Title"] = @T.BookWishlistTitle;
    var wishlistCount = ViewData["WishlistCount"] != null ? (int)ViewData["WishlistCount"]! : 0;
}

<h2 class="m-3">@T.BookWishlistTitle</h2>

<div class="container-fluid mt-3 ms-1">
    @if (!Model.Any())
    {
        <div class="info-alert" role="alert">
            <span class="fw-semibold">@T.EmptyWishlistText</span>
            <a asp-controller="Book" asp-action="BookCatalog">
                @T.BrowseAndAddToWishlistText
            </a>
        </div>
    }
    else
    {
        <div class="mb-3">
            <p class="text-muted">
                <i class="bi bi-info-circle"></i> @wishlistCount @(wishlistCount == 1 ? @T.SingleQuantityText : @T.MultipleQuantityText)
            </p>
        </div>
        <div class="row g-3">
            @foreach (var book in Model)
            {
                <div class="col-sm-4 col-md-3">
                    <div class="custom-card">
                        <div class="card-body d-flex flex-column justify-content-between p-2 p-sm-3">
                            <div>
                                <p class="card-title fw-semibold mb-1 lh-sm" style="font-size: 1rem; min-height: 1rem;">
                                    @book.Title
                                </p>
                                <p class="card-text text-muted small mb-2">
                                    @book.Author
                                </p>
                            </div>
                            <div class="mt-2 text-end">
                                <form asp-action="RemoveFromWishlist" asp-route-id="@book.BookId" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-danger btn-sm px-2 py-1" title=@T.RemoveFromWishlistText>
                                        <i class="bi bi-heart-fill fs-6"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>