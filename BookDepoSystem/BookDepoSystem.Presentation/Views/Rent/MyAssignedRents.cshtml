@model IEnumerable<BookDepoSystem.Data.Models.Rent>
@inject BookDepoSystem.Services.Contracts.IFeedbackService feedbackService

@{
    ViewData["Title"] = @T.AssignedRentsText;
}

<h2 class="m-3">@T.AssignedRentsText</h2>

<div class="table-responsive ">
    <table class="table table-hover table-striped">
        <thead>
        <tr>
            <th>@T.RentDateText</th>
            <th>@T.DueDateText</th>
            <th>@T.ReturnDateText</th>
            <th>@T.RentStatusText</th>
            <th>@T.RentBookText</th>
            <th>@T.RentRenterText</th>
            <th>@T.FeedbackText</th>
        </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
                {
                <tr>
                    <td colspan="6">
                        <span class="d-block w-100 text-center">@T.NotFoundRents</span>
                    </td>
                </tr>
                }
            else
                {
                @foreach (var rent in Model)
                {
                    <tr>
                        <td>@(rent.RentDate.ToString("dd-MM-yyyy HH:mm"))</td>
                        <td>@(rent.DueDate.ToString("dd-MM-yyyy HH:mm"))</td>
                        <td>@(rent.ReturnDate == DateTime.MinValue ? @T.UnreturnedBookText : rent.ReturnDate.ToString("dd-MM-yyyy HH:mm"))</td>
                        <td>
                            @if (rent.Status == @T.ConfirmedRent)
                            {
                                <span class="badge bg-secondary" style="font-size: 1rem;">
                                    @rent.Status
                                </span>
                            }
                            else if (rent.Status == @T.ActiveRent)
                            {
                                <span class="badge bg-primary" style="font-size: 1rem;">
                                    @rent.Status
                                </span>
                            }
                            else if (rent.Status == @T.OverdueRent)
                            {
                                <span class="badge bg-warning" style="font-size: 1rem;">
                                    @rent.Status
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success" style="font-size: 1rem;">
                                    @rent.Status
                                </span>
                            }
                        </td>
                        <td>
                            @rent.Book!.Title
                        </td>
                        <td>@rent.Renter!.Name</td>
                        <td>
                            @if (rent.Status == @T.CompletedRent)
                            {
                                var alreadyHasFeedback = await feedbackService.AlreadyHasFeedback(@rent.RenterId, @rent.BookId);

                                if (!alreadyHasFeedback)
                                {
                                    <a asp-controller="Feedback"
                                       asp-action="Create"
                                       asp-route-bookId="@rent.BookId"
                                       asp-route-renterId="@rent.RenterId"
                                       class="feedback-icon text-primary">
                                        <i class="bi bi-chat-left" title=@T.LeaveFeedbackButton></i>
                                    </a>
                                }
                                else
                                {
                                    <i class="bi bi-check-circle-fill text-success feedback-icon"
                                       title=@T.FeedbackAlreadySubmitted></i>
                                }
                            }
                            else
                            {
                                <span class="text-muted feedback-icon" title=@T.UnreturnedBookText>
                                    <i class="bi bi-clock"></i>
                                </span>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>