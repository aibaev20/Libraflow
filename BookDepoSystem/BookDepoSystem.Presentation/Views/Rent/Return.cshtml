@model RentViewModel

@{
    ViewData["Title"] = @T.ReturnRentTitle;
}

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            new tempusDominus.TempusDominus(document.getElementById("returnDatePicker"), {
                localization: {
                    format: 'dd-MM-yyyy HH:mm',
                },
                display: {
                    sideBySide: true,
                    icons: {
                        time: "bi bi-clock",
                        date: "bi bi-calendar",
                        up: "bi bi-arrow-up",
                        down: "bi bi-arrow-down",
                    },
                },
            });
        });

        function calculatePenalty() {
            const returnDateInput = document.getElementById('returnDateInput');
            const dueDateStr = '@Model.DueDate.ToString("yyyy-MM-ddTHH:mm")';
            const penaltyPerDay = 0.5;

            // Parse the return date from dd-MM-yyyy HH:mm format
            const returnDateValue = returnDateInput.value;

            // Convert dd-MM-yyyy HH:mm to a format JavaScript can parse
            const parts = returnDateValue.split(' ');
            const dateParts = parts[0].split('-');
            const timeParts = parts[1].split(':');

            // Create date as: yyyy-MM-ddTHH:mm
            const returnDate = new Date(
                parseInt(dateParts[2]), // year
                parseInt(dateParts[1]) - 1, // month (0-indexed)
                parseInt(dateParts[0]), // day
                parseInt(timeParts[0]), // hours
                parseInt(timeParts[1]) // minutes
            );

            const dueDate = new Date(dueDateStr);

            console.log('Return Date:', returnDate);
            console.log('Due Date:', dueDate);

            // Calculate difference in days
            const diffTime = returnDate.getTime() - dueDate.getTime();
            const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));

            console.log('Diff Time (ms):', diffTime);
            console.log('Diff Days:', diffDays);

            let penalty = 0;
            if (diffDays > 0) {
                penalty = diffDays * penaltyPerDay;
            }

            console.log('Penalty:', penalty);

            // Update display
            document.getElementById('penaltyDisplay').value = penalty.toFixed(2) + ' €.';
            document.getElementById('penaltyValue').value = penalty.toFixed(2);
        }

        // Calculate on page load
        document.addEventListener('DOMContentLoaded', function() {
            // Add a small delay to ensure TempusDominus has initialized
            setTimeout(calculatePenalty, 100);
        });
    </script>
}

<h2 class="form-group">@T.ReturnRentTitle</h2>

<form asp-action="Return" method="post">
    <input type="hidden" asp-for="RentId" />
    <input type="hidden" asp-for="RentDate" />
    <input type="hidden" asp-for="DueDate" />
    <input type="hidden" asp-for="BookTitle" />
    <input type="hidden" asp-for="RenterName" />

    <div class="form-group">
        <label>@T.RentBookText</label>
        <input class="form-control" value="@Model.BookTitle" disabled />
    </div>

    <div class="form-group">
        <label>@T.RentRenterText</label>
        <input class="form-control" value="@Model.RenterName" disabled />
    </div>

    <div class="form-group">
        <label asp-for="ReturnDate">@T.ReturnDateText</label>
        <div class="input-group" id="returnDatePicker" data-td-target-input="nearest" data-td-target-toggle="nearest">
            <input type="text" class="form-control" asp-for="ReturnDate"
                   id="returnDateInput"
                   data-td-target="#returnDatePicker"
                   onchange="calculatePenalty()" />
            <span class="input-group-text" data-td-toggle="datetimepicker">
                <i class="bi bi-calendar"></i>
            </span>
        </div>
        <span asp-validation-for="ReturnDate" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>@T.RentDateText</label>
        <input class="form-control" value="@Model.RentDate.ToString("dd-MM-yyyy HH:mm")" disabled />
    </div>

    <div class="form-group">
        <label>@T.DueDateText</label>
        <input class="form-control" id="dueDateValue" value="@Model.DueDate.ToString("dd-MM-yyyy HH:mm")" disabled />
    </div>

    <div class="form-group">
        <label>@T.RentPenaltyText</label>
        <input class="form-control" id="penaltyDisplay" disabled />
        <input type="hidden" asp-for="Penalty" id="penaltyValue" />
    </div>

    <div class="form-group">
        <button type="submit" class="btn btn-success">@T.SaveText</button>
        <a asp-action="Rents" class="btn btn-secondary">@T.CancelText</a>
    </div>
</form>